"\n"
)
# ============================================
# STEP 4: DISPLAY FIRST 10 RESULTS
# ============================================
head(
all_results[
, c("Probe_ID", "ENTREZID", "logFC", "t")
],
10
)
# ============================================
# STEP 1: LOAD REQUIRED PACKAGES
# ============================================
library(org.Hs.eg.db)
library(AnnotationDbi)
# ============================================
# STEP 2: VERIFY ENTREZ IDs
# ============================================
valid_entrez <- keys(
org.Hs.eg.db,
keytype = "ENTREZID"
)
all_results$ENTREZID <- as.character(
all_results$ENTREZID
)
all_results$ENTREZID[
!all_results$ENTREZID %in% valid_entrez
] <- NA
cat(
"Valid Entrez IDs:",
sum(!is.na(all_results$ENTREZID)),
"\n"
)
# ============================================
# STEP 3: REMOVE MISSING VALUES
# ============================================
gsea_data <- all_results[
!is.na(all_results$ENTREZID) &
!is.na(all_results$t),
]
# ============================================
# STEP 4: REMOVE DUPLICATE GENES
# Keep the probe with the largest absolute t-value
# ============================================
gsea_data <- gsea_data[
order(abs(gsea_data$t), decreasing = TRUE),
]
gsea_data <- gsea_data[
!duplicated(gsea_data$ENTREZID),
]
# ============================================
# STEP 5: CREATE RANKED GENE LIST
# ============================================
gene_list <- gsea_data$t
names(gene_list) <- gsea_data$ENTREZID
gene_list <- sort(
gene_list,
decreasing = TRUE
)
# ============================================
# STEP 6: DISPLAY RESULTS
# ============================================
cat(
"Total ranked genes:",
length(gene_list),
"\n"
)
head(gene_list, 10)
# ============================================
# ICA 3 - GO BIOLOGICAL PROCESS GSEA
# ============================================
library(clusterProfiler)
library(org.Hs.eg.db)
library(enrichplot)
library(ggplot2)
# STEP 1: Run GSEA
set.seed(123)
gsea_results <- gseGO(
geneList = gene_list,
OrgDb = org.Hs.eg.db,
keyType = "ENTREZID",
ont = "BP",
minGSSize = 10,
maxGSSize = 500,
pvalueCutoff = 1,
pAdjustMethod = "BH",
verbose = FALSE
)
# STEP 2: Convert results into a data frame
gsea_table <- as.data.frame(gsea_results)
# STEP 3: Display results
cat("Total GO pathways:", nrow(gsea_table), "\n")
print(head(gsea_table, 10))
# STEP 4: Count significant pathways
cat(
"\nSignificant pathways (adjusted p-value < 0.05):",
sum(gsea_table$p.adjust < 0.05, na.rm = TRUE),
"\n"
)
# STEP 5: Save results
write.csv(
gsea_table,
"results/tables/GO_GSEA_results.csv",
row.names = FALSE
)
cat("\nGSEA results saved successfully!")
# ============================================
# GSEA DOT PLOT
# ============================================
library(enrichplot)
library(ggplot2)
gsea_dotplot <- dotplot(
gsea_results,
showCategory = 20,
title = "GO Biological Process GSEA in Type 2 Diabetes"
)
print(gsea_dotplot)
# Save figure
ggsave(
"results/figures/GO_GSEA_dotplot.png",
plot = gsea_dotplot,
width = 12,
height = 9,
dpi = 300
)
cat("GSEA dot plot saved successfully!")
significant_pathways <- gsea_table[
!is.na(gsea_table$p.adjust) &
gsea_table$p.adjust < 0.05,
]
write.csv(
significant_pathways,
"results/tables/significant_GO_pathways.csv",
row.names = FALSE
)
head(
significant_pathways[
order(significant_pathways$p.adjust),
c("Description", "NES", "pvalue", "p.adjust")
],
20
)
# ============================================
# IMPROVED GSEA DOT PLOT
# ============================================
library(enrichplot)
library(ggplot2)
library(stringr)
# Create dot plot
gsea_dotplot <- dotplot(
gsea_results,
showCategory = 15,
title = "GO Biological Process GSEA in Type 2 Diabetes"
)
# Improve pathway labels and formatting
gsea_dotplot <- gsea_dotplot +
scale_y_discrete(
labels = function(x) str_wrap(x, width = 35)
) +
theme_minimal() +
theme(
axis.text.y = element_text(size = 9),
axis.text.x = element_text(size = 10),
axis.title = element_text(size = 11),
plot.title = element_text(
size = 14,
face = "bold",
hjust = 0.5
),
legend.text = element_text(size = 9),
legend.title = element_text(size = 10)
)
# Display plot
print(gsea_dotplot)
# Save high-resolution image
ggsave(
"results/figures/GO_GSEA_dotplot_improved.png",
plot = gsea_dotplot,
width = 14,
height = 10,
units = "in",
dpi = 300,
bg = "white"
)
cat("Improved GSEA dot plot saved successfully!")
file.exists(
"results/figures/GO_GSEA_dotplot_improved.png"
)
